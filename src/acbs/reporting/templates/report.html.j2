<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>ACBS Report — {{ recommended }}</title>
  <style>
    body { font-family: Georgia, serif; margin: 2rem; color: #111; }
    h1, h2 { font-family: Segoe UI, sans-serif; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid #ddd; padding: 6px 8px; font-size: 0.9rem; }
    th { background: #f3f4f6; }
    .warn { background: #fff7ed; padding: 0.75rem; }
    .rec { background: #ecfdf5; padding: 1rem; border-left: 4px solid #059669; }
  </style>
</head>
<body>
  <h1>Auto Classifier Benchmark Report</h1>
  <div class="rec">
    <h2>{{ explanation.headline }}</h2>
    {% for p in explanation.paragraphs %}<p>{{ p }}</p>{% endfor %}
    <p>Stability: {{ explanation.stability_pct | round(1) }}%</p>
  </div>
  <h2>Dataset</h2>
  <p>{{ profile.n_rows }} rows × {{ profile.n_features }} features — {{ profile.task_type }}, {{ profile.size_category }}.</p>
  {% if profile.warnings %}
  <div class="warn"><ul>{% for w in profile.warnings %}<li>{{ w }}</li>{% endfor %}</ul></div>
  {% endif %}
  <h2>Results</h2>
  {{ table_html | safe }}
  <h2>Charts</h2>
  {% for fig in figures %}
    {{ fig | safe }}
  {% endfor %}
  <h2>Failed or skipped</h2>
  <ul>
    {% for m in failed %}
      <li>{{ m.model_name }} — {{ m.status }}: {{ m.error or m.notes }}</li>
    {% endfor %}
  </ul>
  <h2>Reproducibility</h2>
  <p>Seed {{ seed }}. Libraries: {{ versions }}</p>
</body>
</html>
